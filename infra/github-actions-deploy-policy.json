{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListMehanOnlineBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::mehanonline-com-site"
    },
    {
      "Sid": "PublishMehanOnlineObjects",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::mehanonline-com-site/*"
    },
    {
      "Sid": "InvalidateMehanOnlineCloudFront",
      "Effect": "Allow",
      "Action": "cloudfront:CreateInvalidation",
      "Resource": "arn:aws:cloudfront::120358397452:distribution/E2YSZGYD73SEVD"
    }
  ]
}
